datasource db {
    provider = "sqlite"
}

generator client {
    provider = "prisma-client"
    output   = "./generated"
}

// Models
model Todo {
    id          String @id
    description String
    createdAt   String
}

model User {
    id          String   @id
    description String   @unique
    createdAt   DateTime @default(now()) @map("created_at")
}
